{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/config.schema.json",
  "title": "Agent Harness configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tracker", "notion", "git"],
  "properties": {
    "version": {"const": 1},
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "workspace", "project"],
      "properties": {
        "provider": {"enum": ["linear", "jira"]},
        "workspace": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "child_issue_type": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"provider": {"const": "jira"}}},
          "then": {"required": ["child_issue_type"], "properties": {"child_issue_type": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "notion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_page_id"],
      "properties": {"parent_page_id": {"type": "string", "minLength": 1}}
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "base_branch"],
      "properties": {
        "remote": {"type": "string", "minLength": 1},
        "base_branch": {"type": "string", "minLength": 1}
      }
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {"type": "string", "minLength": 1}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "port"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "healthcheck": {"type": "string", "pattern": "^/"}
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "trigger"],
      "properties": {
        "enabled": {"type": "boolean"},
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "type", "agent"],
          "properties": {
            "provider": {"const": "linear"},
            "type": {"const": "agent"},
            "agent": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
